<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
        <!-- No black placeholder while Home starts from scratch: what was on screen stays until Home
             can show itself whole, then Home appears at once. The placeholder was black for most
             of a second and then faded out over Home for another third of one. -->
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- The azan card: a small floating window over whatever is on, which stays visible behind it. -->
    <style name="Theme.TvHome.AzanCard" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Toast</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Frosted pill, tvOS style. -->
    <style name="TopButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">13.5dp</item>
        <item name="android:paddingEnd">13.5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:drawablePadding">7dp</item>
        <item name="android:drawableTint">@drawable/pill_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="TopButton" parent="TopButtonBase" />
    <!-- The top menu's pills (Inputs, Settings): bright text and icon in every state, because their
         focus is the gliding dark shape (Glider) rather than a white fill. -->
    <style name="TopMenuButton" parent="TopButton">
        <item name="android:textColor">@drawable/top_text</item>
        <item name="android:drawableTint">@drawable/top_text</item>
    </style>
    <!-- A round icon-only button, like the Settings gear: the name is its content description. -->
    <style name="TopRoundButton" parent="TopMenuButton">
        <item name="android:layout_width">42dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:drawablePadding">0dp</item>
    </style>
</resources>
